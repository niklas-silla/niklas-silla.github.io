---
import { site } from '../data/site';
import { t, type Lang } from '../data/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section id="about" class="section-wrapper animate-on-scroll">
  <div class="section-inner">
    <h2 class="visually-hidden">About</h2>
    <div class="label-grid">
      <p class="mono-label">// about</p>
      <div class="about-content">
        {site.about.map((para) => (
          <p class="about-para" set:html={t(para, lang)} />
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about-content {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .about-para {
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .about-para strong {
    color: var(--accent-gold);
    font-weight: 400;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
